{
  "datasets": [
    {
      "name": "uc_metadata_quality_ds",
      "displayName": "uc_metadata_quality_ds",
      "queryLines": [
        "-- 【要求仕様からの補正】system.information_schema.tables は実在しない\n-- （information_schemaは system カタログ配下ではなく、各カタログ配下に\n-- 存在する。実機の DESCRIBE で確認済み）。\n-- 対象カタログを workspace に固定して workspace.information_schema.tables を使う。\n-- 絶対値より週ごとの推移を見る。低下傾向はテーブル追加にドキュメント整備が\n-- 追いついていないサイン。\nSELECT\n  ROUND(COUNT_IF(comment IS NOT NULL) * 100.0 / COUNT(*), 2) AS comment_rate_pct,\n  ROUND(COUNT_IF(table_owner IS NOT NULL) * 100.0 / COUNT(*), 2) AS owner_rate_pct,\n  COUNT(*) AS total_tables\nFROM workspace.information_schema.tables\nWHERE table_schema != 'information_schema'"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Unity Catalog品質（コメント・タグ・Owner）",
