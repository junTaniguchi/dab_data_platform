{
  "datasets": [
    {
      "name": "cost_per_user_ds",
      "displayName": "cost_per_user_ds",
      "queryLines": [
        "-- system.billing.usage はコンピュート単位の集計であり個人には直接紐づかないため、\n-- 実行時間ベースの近似値として見る。\nSELECT\n  executed_by,\n  SUM(total_duration_ms) AS total_ms\nFROM system.query.history\nWHERE start_time >= current_date() - 7\nGROUP BY executed_by\nORDER BY total_ms DESC"
      ]
    }
  ],
