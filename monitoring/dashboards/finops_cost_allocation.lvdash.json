{
  "datasets": [
    {
      "name": "finops_ds",
      "displayName": "finops_ds",
      "queryLines": [
        "-- project_nameがNULLの行が大きい場合、コスト以前にタグ付けの徹底が課題\n-- （このワークスペースで実際に確認したところ custom_tags['project'] を\n-- 設定していないため現状は全行NULLになる。運用開始前にタグ付けルールの\n-- 整備が必要、という実際の発見）。\nSELECT\n  custom_tags['project'] AS project_name,\n  SUM(usage_quantity) AS total_usage\nFROM system.billing.usage\nWHERE usage_date >= current_date() - 30\nGROUP BY custom_tags['project']\nORDER BY total_usage DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "FinOps（コスト配賦）",
