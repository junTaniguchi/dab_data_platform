                  "fields": [
                    {
                      "name": "job_id",
                      "expression": "`job_id`"
                    },
                    {
                      "name": "avg_mttr_minutes",
                      "expression": "`avg_mttr_minutes`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
