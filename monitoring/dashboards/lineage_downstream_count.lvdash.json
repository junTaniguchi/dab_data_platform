{
  "datasets": [
    {
      "name": "lineage_ds",
      "displayName": "lineage_ds",
      "queryLines": [
        "-- downstream_countが多いテーブルほど変更時の影響範囲が広く、\n-- 事前周知や慎重なテストが必要。\n-- 【要求仕様からの補正】単純なCOUNT(*)だと同一テーブルペアへの\n-- 複数回の書き込みイベントを重複カウントしてしまうため、\n-- COUNT(DISTINCT target_table_full_name)（重複排除した下流テーブル数）に\n-- した方が『依存関係の広さ』という運用目的に対して正確。\nSELECT\n  source_table_full_name,\n  COUNT(DISTINCT target_table_full_name) AS downstream_count\nFROM system.access.table_lineage\nGROUP BY source_table_full_name\nORDER BY downstream_count DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "依存関係・リネージ・下流依存数",
